.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# This is a yarn workspace — an npm lockfile here means someone ran `npm install`
# by mistake and risks dependency drift with yarn.lock.
package-lock.json

# Prisma generated client
/generated/prisma
/prisma/generated
