# Dependencies
node_modules/
/.pnp
.pnp.js

# Build output
/build
/dist
/coverage

# Environment variables — never commit real secrets
.env
.env.*
!.env.example
!.env.*.example

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

