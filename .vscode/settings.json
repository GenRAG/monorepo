{
  "eslint.workingDirectories": [
    {
      "directory": "./plateform_front",
      "changeProcessCWD": true
    },
    {
      "directory": "./plateform_back",
      "changeProcessCWD": true
    }
  ],
  "eslint.validate": [
    "javascript",
    "typescript",
    "typescriptreact",
    "javascriptreact"
  ],
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "editor.formatOnSave": true
}