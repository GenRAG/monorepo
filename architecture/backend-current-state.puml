@startuml

title Platform Back - Current Backend State

skinparam shadowing false
skinparam packageStyle rectangle
left to right direction

package "Application" {
  class AppModule
  class ConfigModule
  class LoggerModule
}

package "Feature Modules" {
  class UsersModule
  class AuthModule
  class WorkspaceModule
  class ProjectModule
  class PrismaModule
}

AppModule --> LoggerModule
AppModule --> ConfigModule
AppModule --> UsersModule
AppModule --> AuthModule
AppModule --> WorkspaceModule
AppModule --> ProjectModule

UsersModule --> PrismaModule
WorkspaceModule --> PrismaModule
ProjectModule --> PrismaModule
AuthModule --> UsersModule
AuthModule --> ConfigModule

package "HTTP Layer" {
  class UsersController
  class AuthController
  class WorkspaceController
  class ProjectController
}

package "Business Layer" {
  class UsersService {
    createUser(request)
    getUser(filter)
    getUsers()
    updateUser(params)
    deleteUser(id)
  }
  class AuthService {
    login(user, response)
    register(registerBody)
    verifyUser(email, password)
    initiatePasswordReset(email)
    verifyPasswordResetToken(verifyTokenBody)
  }
  class TokenService {
    generateAndSendVerificationToken(email)
    verifyEmailToken(emailVerificationToken)
    generateAndSendPasswordResetToken(user)
  }
  class WorkspaceService {
    createWorkspace(workspaceData, userId)
    getAllWorkspacesForUser(userId)
    getWorkspaceById(workspaceId, userId)
  }
  class ProjectService {
    createProject(createProjectRequest)
    getAllProjects(allProjectQuery)
  }
}

package "Security" {
  class JwtAuthGuard
  class LocalAuthGuard
  class WorkspaceRolesGuard
  class JwtStrategy
  class LocalStrategy
  class RolesInWorkspace
}

package "Infrastructure" {
  class PrismaService
  class JwtService
  class ConfigService
  class PrismaClient
}

PrismaService --|> PrismaClient

UsersController --> UsersService
AuthController --> AuthService
AuthController --> TokenService
WorkspaceController --> WorkspaceService
ProjectController --> ProjectService

AuthService --> UsersService
AuthService --> TokenService
AuthService --> JwtService
AuthService --> ConfigService
TokenService --> UsersService
TokenService --> ConfigService
WorkspaceService --> PrismaService
ProjectService --> PrismaService
UsersService --> PrismaService
WorkspaceRolesGuard --> PrismaService

LocalAuthGuard ..> LocalStrategy
JwtAuthGuard ..> JwtStrategy
LocalStrategy --> AuthService
JwtStrategy --> ConfigService
WorkspaceController ..> JwtAuthGuard
WorkspaceController ..> WorkspaceRolesGuard
WorkspaceController ..> RolesInWorkspace
UsersController ..> JwtAuthGuard
ProjectController ..> JwtAuthGuard
AuthController ..> LocalAuthGuard

note right of UsersController
  POST /users
  GET /users
  GET /users/me
  DELETE /users/delete
end note

note right of AuthController
  POST /auth/login
  POST /auth/register
  POST /auth/verification-token
  POST /auth/resend-verification-token
  POST /auth/reset-password
  POST /auth/verify-password-reset-token
end note

note right of WorkspaceController
  POST /workspace/create
  GET /workspace/:id
end note

note right of ProjectController
  POST /project/create
  GET /project/all
end note

package "Prisma Models" {
  class User {
    id : String
    email : String
    name : String?
    password : String?
    isEmailVerified : Boolean
    emailVerificationToken : Int?
    passwordResetToken : Int?
    createdAt : DateTime
    updatedAt : DateTime
  }

  class Workspace {
    id : String
    name : String
    description : String?
    createdAt : DateTime
    updatedAt : DateTime
  }

  class Project {
    id : String
    name : String
    description : String?
    workspaceId : String
    createdAt : DateTime
    updatedAt : DateTime
  }

  class UserWorkspace {
    userId : String
    workspaceId : String
    role : UserRole
    PK : (userId, workspaceId)
  }

  enum UserRole {
    ADMIN
    EDITOR
    VIEWER
  }
}

User "1" -- "0..*" UserWorkspace
Workspace "1" -- "0..*" UserWorkspace
Workspace "1" -- "0..*" Project
UserWorkspace --> UserRole

@enduml
