# Copier en .env (dev) ou .env.test (e2e) — ne jamais committer de vraies valeurs.
# Liste exhaustive des variables lues par l'API (ConfigService) et par Prisma.

# ── Serveur ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8080
# Origine(s) autorisée(s) par CORS (credentials: true), séparées par des virgules. Sert aussi aux liens des emails.
FRONTEND_URL=http://localhost:3000

# ── Base de données (Prisma / PostgreSQL) ────────────────────────────────────────
# docker-compose : postgres sur 5433 (dev), postgres_test sur 5434 (e2e)
DATABASE_URL=postgres://admin:password@localhost:5433/database

# ── Redis (BullMQ, blacklist JWT, anti brute-force) ──────────────────────────────
# En production seule REDIS_URL est lue ; ailleurs REDIS_HOST / REDIS_PORT.
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Authentification ─────────────────────────────────────────────────────────────
# Secret de signature des JWT (et clé HMAC des codes OTP) : longue chaîne aléatoire.
JWT_SECRET=change-me
# Durées au format `ms` (ex. 15m, 1h, 7d)
JWT_EXPIRATION=7d
TOKEN_VALIDITY=15m
TOKEN_RESEND_INTERVAL=1m
# Optionnel : verrouillage après N échecs de connexion (défauts : 5 échecs, 900 s)
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_BLOCK_TTL_SECONDS=900

# ── Emails (Resend) ──────────────────────────────────────────────────────────────
# SEND_EMAILS=false en dev : aucun email envoyé, connexion possible sans vérifier l'email.
SEND_EMAILS=false
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@example.com

# ── Stockage des documents (S3) ──────────────────────────────────────────────────
AWS_REGION=eu-west-3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
# Délai minimal entre deux ré-indexations manuelles d'un document (format `ms`)
DOCUMENT_INDEXING_RETRY_INTERVAL=1m

# ── Moteur RAG externe ───────────────────────────────────────────────────────────
RAGENGINE_URL=http://localhost:8000
RAGENGINE_API_KEY=
# true : utilise l'endpoint /rag/stream/mock du moteur (dev)
RAG_MOCK=false
