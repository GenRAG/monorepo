model Agent {
  id          String      @id @default(cuid())
  name        String
  description String?
  status      AgentStatus
  createdAt   DateTime    @default(now())
  createdBy   String
  updatedAt   DateTime    @updatedAt
  updatedBy   String
  workspaceId String
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workflows   Workflow[]
  documents   Document[]
}

enum AgentStatus {
  DEVELOPMENT
  STAGING
  PRODUCTION
}