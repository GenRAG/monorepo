model Agent {
  id            String         @id @default(cuid())
  name          String
  description   String?
  status        AgentStatus    @default(DEVELOPMENT)
  retentionDays Int?
  createdAt     DateTime       @default(now())
  createdBy     String
  updatedAt     DateTime       @updatedAt
  updatedBy     String
  workspaceId   String
  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workflows          Workflow[]
  documents          Document[]
  deployments        AgentVersion[]
  onboardingSession  OnboardingSession?
  conversations      Conversation[]
  members            AgentMember[]
  queryLogs          AgentQueryLog[]
}

model AgentVersion {
  id              String      @id @default(cuid())
  version         Int
  name            String
  changelog       String?
  fromStatus      AgentStatus
  toStatus        AgentStatus
  workflowVersion Int?
  agentId         String
  agent           Agent       @relation(fields: [agentId], references: [id], onDelete: Cascade)
  createdAt       DateTime    @default(now())
  createdBy       String?
  createdByUser   User?       @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@unique([agentId, version])
}

model AgentMember {
  id        String   @id @default(cuid())
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([agentId, userId])
}

model AgentQueryLog {
  id          String         @id @default(cuid())
  agentId     String
  agent       Agent          @relation(fields: [agentId], references: [id], onDelete: Cascade)
  query       String
  durationMs  Int
  status      QueryLogStatus
  creditsUsed Int            @default(1)
  createdAt   DateTime       @default(now())
}

enum AgentStatus {
  DEVELOPMENT
  PRODUCTION
}

enum QueryLogStatus {
  SUCCESS
  ERROR
  OUT_OF_CREDITS
}