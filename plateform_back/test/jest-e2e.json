{
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": ".",
    "testEnvironment": "node",
    "testRegex": ".*\\.e2e-spec\\.ts$",
    "transform": {
        "^.+\\.ts$": "ts-jest"
    },
    "moduleNameMapper": {
        "^src/(.*)$": "<rootDir>/../src/$1",
        "^generated/(.*)$": "<rootDir>/../src/generated"
    },
    "testTimeout": 30000
}