# Copier en .env — variables injectées au build par Create React App (préfixe REACT_APP_).
# Elles finissent dans le bundle public : n'y mettre aucun secret.

# URL de l'API plateform_back (sans slash final). Les cookies d'auth sont envoyés en cross-origin
# (credentials: "include") : l'origine du front doit figurer dans FRONTEND_URL côté back.
REACT_APP_BACKEND_URL=http://localhost:8080

# Client OAuth Google utilisé par le bouton « Continuer avec Google ».
REACT_APP_GOOGLE_CLIENT_ID=
