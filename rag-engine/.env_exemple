OPENROUTER_API_KEY=sk-or-v1-xxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Generate each secret with: openssl rand -hex 32  (hex keeps them URL-safe)
RAG_ENGINE_API_KEY=change-me
REDIS_PASSWORD=change-me
# Outside Docker only; docker-compose builds REDIS_URL from REDIS_PASSWORD
REDIS_URL=redis://:change-me@localhost:6379/0
COHERE_API_KEY=xxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ZEROENTROPY_API_KEY=ze_xxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Minio Configuration
MINIO_USER=genrag-admin
MINIO_PASSWORD=change-me
S3_ENDPOINT=http://minio:9000
BUCKET_NAME=genrag-documents

# Qdrant Configuration
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=change-me

# Langfuse Configuration
LANGFUSE_SECRET_KEY = "sk-lf-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
LANGFUSE_PUBLIC_KEY = "pk-lf-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
LANGFUSE_BASE_URL = "https://cloud.langfuse.com"



