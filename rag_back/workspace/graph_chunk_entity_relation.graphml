  <graph edgedefault="undirected">
    <node id="Valentin Peron">
      <data key="d0">person</data>
      <data key="d1">Valentin Peron is a student at Epitech Rennes, part of the class of 2027, who completed an internship developing a Machine Learning Pipeline for Automated Extraction of Articles from Newspaper Archives.</data>
      <data key="d2">chunk-bc514f2622501600ee2b8e93dccb447a</data>
    </node>
    <node id="Mme Laurene Boucard">
      <data key="d0">person</data>
      <data key="d1">Mme Laurene Boucard is an academic tutor associated with Epitech Rennes, involved in guiding Valentin Peron's internship work.</data>
      <data key="d2">chunk-bc514f2622501600ee2b8e93dccb447a</data>
    </node>
    <node id="Mr Julien Perron">
      <data key="d0">person</data>
      <data key="d1">Mr Julien Perron serves as a company tutor and is the Head of AI and Data Science at Ouest-France, supervising Valentin Peron's internship project.</data>
      <data key="d2">chunk-bc514f2622501600ee2b8e93dccb447a</data>
    </node>
    <node id="Michel Le Nouy">
      <data key="d0">person</data>
      <data key="d1">Michel Le Nouy is the Head of Applied Research and AI and Co-Director of the Synapses LabCom, who assisted Valentin Peron in understanding Ouest-France's history and AI research.</data>
      <data key="d2">chunk-bc514f2622501600ee2b8e93dccb447a</data>
    </node>
    <node id="Tanguy Launay">
      <data key="d0">person</data>
      <data key="d1">Tanguy Launay provided invaluable support and guidance to Valentin Peron during his internship.</data>
      <data key="d2">chunk-bc514f2622501600ee2b8e93dccb447a</data>
    </node>
    <node id="Victor Klötzer">
      <data key="d0">person</data>
      <data key="d1">Victor Klötzer provided invaluable support and guidance to Valentin Peron during his internship.</data>
      <data key="d2">chunk-bc514f2622501600ee2b8e93dccb447a</data>
    </node>
    <node id="The SIRAI team">
      <data key="d0">organization</data>
      <data key="d1">A team within Ouest-France, including Baye-Lahad Mbacke, Thomas Girault, Ibrahima Ba, Melvin Leveque, Cédric Jezequel, and Cédric Moreau, which provided expertise and support during the internship.</data>
      <data key="d2">chunk-bc514f2622501600ee2b8e93dccb447a</data>
    </node>
    <node id="Numeric support team and SIN team">
      <data key="d0">organization</data>
      <data key="d1">Teams within Ouest-France that welcomed Valentin Peron and contributed to his internship experience.</data>
      <data key="d2">chunk-bc514f2622501600ee2b8e93dccb447a</data>
    </node>
    <node id="Epitech Rennes">
      <data key="d0">organization</data>
      <data key="d1">Epitech Rennes is an educational institution where Valentin Peron studied and completed his internship program.</data>
      <data key="d2">chunk-bc514f2622501600ee2b8e93dccb447a</data>
    </node>
    <node id="Ouest-France">
      <data key="d0">organization</data>
      <data key="d1">Ouest-France is a major media organization that reported a revenue of €296.8 million in 2023, operating in the media industry with over 1,600 employees. The company has a clear AI strategy focusing on data sovereignty and ethical AI usage.&lt;SEP&gt;Ouest-France is a media organization that demands data sovereignty and internal AI vision compliance in document processing.&lt;SEP&gt;Ouest-France is a prominent French media organization engaged in print media and digital platforms, and recognized as a leading daily newspaper in France.&lt;SEP&gt;Ouest-France is an organization where the author of the document interned, working on developing a machine learning pipeline for automated article extraction from historical newspaper archives.</data>
      <data key="d2">chunk-bc514f2622501600ee2b8e93dccb447a&lt;SEP&gt;chunk-0596139f33034f1465d3ec158d3cc134&lt;SEP&gt;chunk-994dfab33a72a337746c11fed565555b&lt;SEP&gt;chunk-ee8de8645b4a1e06c900e60bf623000e</data>
    </node>
    <node id="The SIPA Ouest-France group">
      <data key="d0">organization</data>
      <data key="d1">A group to which Ouest-France belongs, involved in multimedia content expansion including the launch of a national television channel, Novo 19.</data>
      <data key="d2">chunk-bc514f2622501600ee2b8e93dccb447a</data>
    </node>
    <node id="Novo 19">
      <data key="d0">organization</data>
      <data key="d1">Novo 19 is a national television channel on the French TNT network, set to start broadcasting on 1st September 2025 as part of the SIPA Ouest-France group's multimedia expansion.</data>
      <data key="d2">chunk-bc514f2622501600ee2b8e93dccb447a</data>
    </node>
    <node id="Machine Learning Pipeline for Automated Extraction of Articles">
      <data key="d0">category</data>
      <data key="d1">A project developed during Valentin Peron's internship to automate the extraction of articles from newspaper archives using a custom pipeline that operates locally within the Ouest-France infrastructure.</data>
      <data key="d2">chunk-bc514f2622501600ee2b8e93dccb447a</data>
    </node>
    <node id="Ouest-Éclair">
      <data key="d0">organization</data>
      <data key="d1">Ouest-Éclair is the former name of the newspaper now known as Ouest-France, covering the period from 1899 to 2000.&lt;SEP&gt;Ouest-Éclair is the former title of Ouest-France, changed after World War II, and involved in the article extraction project.</data>
      <data key="d2">chunk-bc514f2622501600ee2b8e93dccb447a&lt;SEP&gt;chunk-994dfab33a72a337746c11fed565555b</data>
    </node>
    <node id="Baye-Lahad Mbacke">
      <data key="d0">person</data>
      <data key="d1">Baye-Lahad Mbacke is a member of the SIRAI team at Ouest-France, contributing to Valentin Peron's internship project.</data>
      <data key="d2">chunk-bc514f2622501600ee2b8e93dccb447a</data>
    </node>
